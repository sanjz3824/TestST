{
  "name": "NSE Stock Portfolio Tracker",
  "short_name": "StockTrack",
  "description": "Track your NSE stock portfolio across multiple brokers, calculate weighted average price, and monitor P&L.",
  "start_url": "./stock-portfolio-app.html",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0C0C09",
  "theme_color": "#0C0C09",
  "categories": ["finance", "investing"],
  "lang": "en-IN",
  "dir": "ltr",
  "scope": "./",
  "icons": [
    {
      "src": "icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Calculator",
      "short_name": "Calc",
      "url": "./stock-portfolio-app.html?tab=calculator",
      "description": "Open Average Price Calculator"
    },
    {
      "name": "Add Stock",
      "short_name": "Add",
      "url": "./stock-portfolio-app.html?tab=add",
      "description": "Add a new stock holding"
    },
    {
      "name": "Widget",
      "short_name": "Widget",
      "url": "./widget.html",
      "description": "Portfolio summary widget"
    }
  ],
  "widgets": [
    {
      "name": "Portfolio Widget",
      "description": "Shows your total portfolio value and P&L",
      "tag": "stocktrack-portfolio",
      "ms_ac_template": "widget-data.json",
      "data": "/widget-data.json",
      "screenshots": [],
      "icons": [
        {
          "src": "icon-192.svg",
          "sizes": "192x192"
        }
      ],
      "backgrounds": [
        {
          "src": "icon-192.svg"
        }
      ]
    }
  ],
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "share_target": {
    "action": "./stock-portfolio-app.html?share-target",
    "method": "GET",
    "params": {
      "title": "text",
      "url": "link"
    }
  }
}
